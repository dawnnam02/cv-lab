; H15_mimic Klipper 꼴 흉내 (실제 슬라이서 출력 아님, 시험용 입력)
; gcode_flavor = klipper
EXCLUDE_OBJECT_DEFINE NAME=part CENTER=105,105
PRINT_START BED=60 EXTRUDER=210
BED_MESH_CALIBRATE
G21
G90
M83
SET_PRINT_STATS_INFO TOTAL_LAYER=2
;LAYER_CHANGE
;Z:0.2
SET_PRINT_STATS_INFO CURRENT_LAYER=1
EXCLUDE_OBJECT_START NAME=part
G1 Z0.2 F600
G1 X100 Y100 F3000
;TYPE:Outer wall
G1 X110 Y100 E0.31354
G1 X110 Y110 E0.31354
G1 X100 Y110 E0.31354
G1 X100 Y100 E0.31354
EXCLUDE_OBJECT_END NAME=part
;LAYER_CHANGE
;Z:0.4
SET_PRINT_STATS_INFO CURRENT_LAYER=2
EXCLUDE_OBJECT_START NAME=part
G1 Z0.4 F600
G1 X100 Y100 F3000
;TYPE:Outer wall
G1 X110 Y100 E0.31354
G1 X110 Y110 E0.31354
G1 X100 Y110 E0.31354
G1 X100 Y100 E0.31354
EXCLUDE_OBJECT_END NAME=part
G1 E-0.8
PRINT_END
